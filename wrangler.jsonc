{
  "name": "acsm-converter",
  "main": "src/index.js",
  "compatibility_date": "2026-04-16",
  // The converter now runs on Fly.io and owns its own Postgres-backed
  // credential cache, so the Worker is a thin proxy: no Cloudflare Container,
  // no Durable Object, no D1 binding. The migrations below record that the
  // MyContainer Durable Object class (created in v1) has been removed.
  "migrations": [
    {
      "new_sqlite_classes": ["MyContainer"],
      "tag": "v1",
    },
    {
      "deleted_classes": ["MyContainer"],
      "tag": "v2",
    },
  ],
  "routes": [
    {
      "pattern": "www.acsm-converter.com",
      "custom_domain": true,
    },
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": false,
    },
  },
}
